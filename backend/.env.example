# EventPilot AI - Backend Environment Variables
# Copy this file to .env and configure appropriate values for your environment.

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Supabase / PostgreSQL Database URLs
# Connection pooling URL (Port 6543) used by application runtime
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
# Direct connection URL (Port 5432) used by Prisma CLI migrations
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API Credentials
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Anon / Public Key (Safe for public client requests if needed)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role Key (Keep secret! Only used by trusted backend operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Verification Secret (Must match Supabase Auth JWT Secret in Settings -> API)
JWT_SECRET=your_jwt_secret_min_32_chars_long_placeholder

# Optional Internal AI Service URL
AI_SERVICE_URL=http://localhost:8000

