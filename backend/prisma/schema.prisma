// EventPilot AI - Prisma Schema
// Database: Supabase PostgreSQL (Exclusively)
// Documentation: See DATABASE_DESIGN.md

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Profile model linked directly to Supabase Auth user (auth.users.id)
model Profile {
  id          String   @id @db.Uuid // Supabase auth.users UUID
  email       String   @unique
  fullName    String?
  avatarUrl   String?
  phoneNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events Event[]

  @@map("profiles")
}

/// Event model representing celebrations & events created by users
model Event {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  type        String   @default("Wedding") // e.g. Wedding, Birthday, Corporate event
  date        DateTime
  location    String
  description String?
  budget      Decimal  @default(0.00) @db.Decimal(12, 2)
  guestCount  Int      @default(0)
  theme       String?
  currency    String   @default("INR")
  status      String   @default("planning") // planning, confirmed, in_progress, completed, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationship to Profile (Supabase Auth user)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phase 3 Relations
  budgetCategories BudgetCategory[]
  expenses         Expense[]
  guests           Guest[]
  tasks            Task[]
  timelineItems    TimelineItem[]

  @@index([userId])
  @@index([status])
  @@index([date])
  @@map("events")
}

/// BudgetCategory model representing budget allocations for individual events
model BudgetCategory {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @db.Uuid
  name            String
  allocatedAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  description     String?
  color           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("budget_categories")
}

/// Expense model tracking planned and actual event spending
model Expense {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @db.Uuid
  categoryId      String?   @db.Uuid
  title           String
  description     String?
  estimatedAmount Decimal   @default(0.00) @db.Decimal(12, 2)
  actualAmount    Decimal?  @db.Decimal(12, 2)
  expenseDate     DateTime?
  paymentStatus   String    @default("pending") // pending, partially_paid, paid
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([categoryId])
  @@index([paymentStatus])
  @@map("expenses")
}

/// Guest model managing attendees and RSVPs for an event
model Guest {
  id                String   @id @default(uuid()) @db.Uuid
  eventId           String   @db.Uuid
  fullName          String
  email             String?
  phoneNumber       String?
  guestCategory     String?  // Family, Friends, Colleagues, Others
  rsvpStatus        String   @default("pending") // pending, invited, attending, declined
  plusOneAllowed    Boolean  @default(false)
  plusOneCount      Int      @default(0)
  dietaryPreference String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([rsvpStatus])
  @@map("guests")
}

/// Task model managing event-planning activities
model Task {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @db.Uuid
  title       String
  description String?
  dueDate     DateTime?
  priority    String    @default("medium") // low, medium, high, urgent
  status      String    @default("todo") // todo, in_progress, completed, cancelled
  assignedTo  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dependencies    TaskDependency[] @relation("TaskAsSubject")
  prerequisitesOf TaskDependency[] @relation("TaskAsPrerequisite")

  @@index([eventId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("tasks")
}

/// TaskDependency model defining prerequisites between tasks within an event
model TaskDependency {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @db.Uuid
  dependsOnTaskId String   @db.Uuid
  createdAt       DateTime @default(now())

  task          Task @relation("TaskAsSubject", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskAsPrerequisite", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

/// TimelineItem model representing important event milestones and scheduled activities
model TimelineItem {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @db.Uuid
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  location    String?
  category    String?   // Ceremony, Catering, Decoration, Photography, Other
  status      String    @default("scheduled")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([startTime])
  @@map("timeline_items")
}
