// EventPilot AI - Prisma Schema
// Database: Supabase PostgreSQL (Exclusively)
// Documentation: See DATABASE_DESIGN.md

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Profile model linked directly to Supabase Auth user (auth.users.id)
model Profile {
  id          String   @id @db.Uuid // Supabase auth.users UUID
  email       String   @unique
  fullName    String?
  avatarUrl   String?
  phoneNumber String?
  role        String   @default("user") // "user" or "admin"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events                 Event[]
  submittedContributions VendorContribution[] @relation("SubmittedContributions")
  reviewedContributions  VendorContribution[] @relation("ReviewedContributions")
  savedVendors           MyVendor[]

  @@index([role])
  @@map("profiles")
}

/// Event model representing celebrations & events created by users
model Event {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  name        String
  type        String   @default("Wedding") // e.g. Wedding, Birthday, Corporate event
  date        DateTime
  location    String
  description String?
  budget      Decimal  @default(0.00) @db.Decimal(12, 2)
  guestCount  Int      @default(0)
  theme       String?
  currency    String   @default("INR")
  status      String   @default("planning") // planning, confirmed, in_progress, completed, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationship to Profile (Supabase Auth user)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phase 3 Relations
  budgetCategories BudgetCategory[]
  expenses         Expense[]
  guests           Guest[]
  tasks            Task[]
  timelineItems    TimelineItem[]

  // Phase 4 Relations
  eventVendors     EventVendor[]
  personalizedIdeas PersonalizedIdea[]

  @@index([userId])
  @@index([status])
  @@index([date])
  @@map("events")
}

/// BudgetCategory model representing budget allocations for individual events
model BudgetCategory {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @db.Uuid
  name            String
  allocatedAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  description     String?
  color           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("budget_categories")
}

/// Expense model tracking planned and actual event spending
model Expense {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @db.Uuid
  categoryId      String?   @db.Uuid
  title           String
  description     String?
  estimatedAmount Decimal   @default(0.00) @db.Decimal(12, 2)
  actualAmount    Decimal?  @db.Decimal(12, 2)
  expenseDate     DateTime?
  paymentStatus   String    @default("pending") // pending, partially_paid, paid
  notes           String?
  eventVendorId   String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category    BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  eventVendor EventVendor?    @relation(fields: [eventVendorId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([categoryId])
  @@index([paymentStatus])
  @@index([eventVendorId])
  @@map("expenses")
}

/// Guest model managing attendees and RSVPs for an event
model Guest {
  id                String   @id @default(uuid()) @db.Uuid
  eventId           String   @db.Uuid
  fullName          String
  email             String?
  phoneNumber       String?
  guestCategory     String?  // Family, Friends, Colleagues, Others
  rsvpStatus        String   @default("pending") // pending, invited, attending, declined
  plusOneAllowed    Boolean  @default(false)
  plusOneCount      Int      @default(0)
  dietaryPreference String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([rsvpStatus])
  @@map("guests")
}

/// Task model managing event-planning activities
model Task {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @db.Uuid
  title       String
  description String?
  dueDate     DateTime?
  priority    String    @default("medium") // low, medium, high, urgent
  status      String    @default("todo") // todo, in_progress, completed, cancelled
  assignedTo  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dependencies    TaskDependency[] @relation("TaskAsSubject")
  prerequisitesOf TaskDependency[] @relation("TaskAsPrerequisite")

  @@index([eventId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("tasks")
}

/// TaskDependency model defining prerequisites between tasks within an event
model TaskDependency {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @db.Uuid
  dependsOnTaskId String   @db.Uuid
  createdAt       DateTime @default(now())

  task          Task @relation("TaskAsSubject", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskAsPrerequisite", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

/// TimelineItem model representing important event milestones and scheduled activities
model TimelineItem {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @db.Uuid
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  location    String?
  category    String?   // Ceremony, Catering, Decoration, Photography, Other
  status      String    @default("scheduled")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([startTime])
  @@map("timeline_items")
}

/// CommunityVendor model representing shared, approved vendor knowledge base
model CommunityVendor {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  category         String   // Venue, Catering, Photography, Videography, Decoration, Music/DJ, Makeup & Hair, Mehndi, Planner, Attire, Transportation, Other
  description      String?
  city             String
  state            String?
  country          String   @default("India")
  address          String?
  publicPhone      String?
  publicEmail      String?
  websiteUrl       String?
  socialLinks      Json?    // e.g. { instagram: "...", facebook: "...", youtube: "..." }
  serviceAreas     Json?    // e.g. ["Mumbai", "Thane", "Navi Mumbai"]
  eventTypes       Json?    // e.g. ["Wedding", "Birthday", "Corporate", "Anniversary"]
  priceInformation Json?    // e.g. { startingPrice: 50000, maxPrice: 200000, priceRange: "$$" / "mid", pricingModel: "per_day" }
  rating           Decimal? @db.Decimal(3, 2)
  status           String   @default("pending") // pending, approved, rejected, suspended
  submittedBy      String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contributions VendorContribution[]
  savedByUsers  MyVendor[]
  eventVendors  EventVendor[]

  @@index([category])
  @@index([city])
  @@index([status])
  @@map("community_vendors")
}

/// VendorContribution model tracking community vendor submissions and admin review
model VendorContribution {
  id               String    @id @default(uuid()) @db.Uuid
  vendorId         String    @db.Uuid
  submittedBy      String    @db.Uuid
  relationshipType String    // customer, past_client, acquaintance, other
  sourceDescription String?  // how the submitter learned about this vendor
  privateNotes     String?   // submitter's private notes
  consentConfirmed Boolean   @default(false)
  reviewStatus     String    @default("pending") // pending, approved, rejected
  reviewedBy       String?   @db.Uuid
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vendor    CommunityVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  submitter Profile         @relation("SubmittedContributions", fields: [submittedBy], references: [id], onDelete: Cascade)
  reviewer  Profile?        @relation("ReviewedContributions", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([submittedBy])
  @@index([reviewStatus])
  @@map("vendor_contributions")
}

/// MyVendor model tracking customers' saved personal vendor bookmarks
model MyVendor {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  vendorId      String   @db.Uuid
  personalNotes String?
  savedAt       DateTime @default(now())

  user   Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor CommunityVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
  @@map("my_vendors")
}

/// EventVendor model managing vendor assignments, costs, and statuses within an event
model EventVendor {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @db.Uuid
  vendorId        String   @db.Uuid
  category        String
  selectionStatus String   @default("shortlisted") // shortlisted, contacted, quoted, hired, rejected
  contactStatus   String   @default("not_contacted") // not_contacted, contacted, meeting_scheduled, proposal_received, contract_signed
  estimatedCost   Decimal  @default(0.00) @db.Decimal(12, 2)
  actualCost      Decimal? @db.Decimal(12, 2)
  currency        String   @default("INR")
  privateNotes    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor   CommunityVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([eventId, vendorId])
  @@index([eventId])
  @@index([vendorId])
  @@index([selectionStatus])
  @@map("event_vendors")
}

/// PersonalizedIdea model representing tailored celebration ideas and concepts
model PersonalizedIdea {
  id                   String   @id @default(uuid()) @db.Uuid
  eventId              String   @db.Uuid
  title                String
  description          String
  category             String   // decor, food, entertainment, activities, themes, photography, venue
  estimatedBudgetRange String
  matchReason          String
  alternatives         Json?    // list of alternatives as JSON string array
  isSaved              Boolean  @default(false)
  tags                 Json?    // tags as JSON string array
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([category])
  @@map("personalized_ideas")
}
