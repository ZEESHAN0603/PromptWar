// EventPilot AI - Prisma Schema
// Database: Supabase PostgreSQL (Exclusively)
// Documentation: See DATABASE_DESIGN.md

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Profile model linked directly to Supabase Auth user (auth.users.id)
model Profile {
  id        String   @id // Supabase auth.users UUID
  email     String   @unique
  fullName  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@map("profiles")
}

/// Event model representing celebrations & events created by users
model Event {
  id          String   @id @default(uuid())
  userId      String
  name        String
  type        String   @default("Wedding") // e.g. Wedding, Birthday, Corporate event
  date        DateTime
  location    String
  description String?
  budget      Decimal  @default(0.00) @db.Decimal(12, 2)
  guestCount  Int      @default(0)
  theme       String?
  status      String   @default("planning") // planning, confirmed, in_progress, completed, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationship to Profile (Supabase Auth user)
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([date])
  @@map("events")
}
