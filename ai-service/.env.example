# EventPilot AI - AI Microservice Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Internal API Authentication / Shared Secret
INTERNAL_API_SECRET=development-internal-ai-secret-key-32-chars

# Gemini API Integration (Prepared for Phase 5-7, not required in Phase 1)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend URL for callback/internal calls if needed
BACKEND_INTERNAL_URL=http://backend:5000
